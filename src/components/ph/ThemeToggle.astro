---
import Icon from "./Icon.astro";

type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<button
  type="button"
  data-ph-theme-toggle
  aria-label="Toggle dark mode"
  aria-pressed="false"
  title="Middle-click to follow your system"
  class:list={["inline-flex cursor-pointer items-center justify-center p-1.5 transition-transform duration-100 active:scale-[0.97]", className]}
>
  <Icon name="sun" class="size-4.5 dark:hidden" />
  <Icon name="moon" class="hidden size-4 -rotate-6 dark:block" />
</button>

<script>
  import { applyTheme, getTheme, setTheme } from "./theme";

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-ph-theme-toggle]");
  const updateButtons = () => {
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(document.documentElement.classList.contains("dark")));
    }
  };

  for (const b of buttons) {
    b.addEventListener("click", () => {
      setTheme(getTheme() === "dark" ? "light" : "dark");
      updateButtons();
    });
    b.addEventListener("auxclick", (e) => {
      if (e.button === 1) {
        setTheme(null);
        updateButtons();
      }
    });
  }

  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    applyTheme(getTheme());
    updateButtons();
  });
  updateButtons();
</script>
